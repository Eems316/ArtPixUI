{
  "name": "art-pix-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/art-pix-ui.js",
  "module": "./dist/art-pix-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/art-pix-ui.js"
    },
    "./styles.css": "./dist/art-pix-ui.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "build": "npm run typecheck && vite build",
    "build:playground": "vite build --config vite.playground.config.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.0"
  }
}
